# ─── ODDS API (odds-api.net) ─────────────────────────────────
# Free plan: 100 req/hr · 2 bookmakers incluidos
ODDS_API_KEY=your_odds_api_net_key_here
ODDS_API_BASE_URL=https://api.odds-api.net/v1

# ─── THE ODDS API (the-odds-api.com) ─────────────────────────
# Free plan: 500 req/mes · muchos más bookmakers · RECOMENDADO
# Consigue tu key en: https://the-odds-api.com/
THEODDS_API_KEY=your_theodds_key_here
# Regiones a consultar (eu,uk = Europa; añade us,au para más casas)
# AVISO: cada región cuenta como 1 req del cupo (eu,uk = 2 req por llamada)
THEODDS_REGIONS=eu,uk
# Minutos entre llamadas a The Odds API para preservar el cupo de 500 req/mes
THEODDS_CACHE_MINUTES=10

# ─── TELEGRAM ────────────────────────────────────────────────
# Obtén el token de @BotFather y el chat_id de @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── BANKROLL & FILTROS ──────────────────────────────────────
# Bankroll en euros para calcular los stakes de cada apuesta
BANKROLL=100.0
# Margen mínimo (%) para enviar alerta — por debajo no vale la pena
MIN_ARB_MARGIN=1.5
# Margen máximo (%) — por encima es sospechoso / cuota ya corregida
MAX_ARB_MARGIN=15.0
# Segundos entre cada escaneo
SCAN_INTERVAL=30
# Filtro de deporte (dejar vacío = todos)
SPORT_FILTER=soccer
# Filtro de liga — "world cup" detecta el Mundial automáticamente (dejar vacío = todos)
LEAGUE_FILTER=world cup
# Solo usar casas con licencia DGOJ activa en España (True/False)
SPAIN_ONLY=True
# Mercados a escanear: h2h=resultado, totals=más/menos goles, btts=ambos marcan
MARKETS=h2h,totals,btts
# Deportes extra además del Mundial (separados por coma, vacío = solo fútbol WC)
# Ejemplos: tennis_atp_wimbledon, basketball_nba, americanfootball_nfl
EXTRA_SPORTS=

# ─── VALUE BETTING (+EV) ──────────────────────────────────────────────────────
# Edge mínimo (%) para alertar una value bet: (cuota × P_real − 1) × 100
# 5% = alertas frecuentes · 10% = solo las más jugosas
MIN_VALUE_EDGE=5.0
